// ─── Prisma Schema for FitSpace ────────────────────────────
// Models: User, Meal, Workout, WaterLog, SleepLog, MoodLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Goals
  dailyWaterGoal    Float @default(2500) // ml
  dailyCaloriesGoal Float @default(2000) // kcal
  dailySleepGoal    Float @default(8)    // hours
  dailyWorkoutGoal  Int   @default(30)   // minutes

  // Profile (optional for AI context)
  weight Float? // kg
  height Float? // cm
  avatar String? // emoji or icon name

  meals            Meal[]
  workouts         Workout[]
  waterLogs        WaterLog[]
  sleepLogs        SleepLog[]
  moodLogs         MoodLog[]
  gratitudeEntries GratitudeEntry[]
  leaderboardEntries LeaderboardEntry[]
}

// ─── Meal ──────────────────────────────────────────────────
model Meal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  description String
  mealType    String   // breakfast, lunch, dinner, snack
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  aiAnalysis  String?  // raw AI response JSON
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ─── Workout ───────────────────────────────────────────────
model Workout {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // cardio, strength, flexibility, sports, etc.
  name        String
  duration    Int      // minutes
  calories    Float?
  notes       String?
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ─── Water Intake ──────────────────────────────────────────
model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float    // milliliters
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Sleep ─────────────────────────────────────────────────
model SleepLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hours     Float
  quality   Int      // 1-5 rating
  notes     String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Mood / Wellness ───────────────────────────────────────
model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      String   // happy, calm, stressed, tired, energetic, sad
  energy    Int      // 1-5
  notes     String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Gratitude ─────────────────────────────────────────────
model GratitudeEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Leaderboard ───────────────────────────────────────────
model LeaderboardEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  // Weekly stats
  weekStart    DateTime
  weekEnd      DateTime

  // Aggregated metrics
  totalWorkouts      Int      @default(0)
  workoutMinutes     Int      @default(0)
  workoutsCalories   Float    @default(0)
  mealsLogged        Int      @default(0)
  totalCalories      Float    @default(0)
  waterIntake        Float    @default(0)
  sleepHours         Float    @default(0)
  moodScore          Float    @default(0)

  // Computed score (for ranking)
  score          Float    @default(0)
  rank           Int?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@index([score])
}
