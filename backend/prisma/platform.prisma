// ─── Platform Schema (Dedicated for v1 Features) ────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

// ─── Enums (Platform Only) ──────────────────────────────────
enum Role {
  USER
  ADMIN
  MANAGER
}

enum TaskStatus {
  PENDING
  COMPLETED
}

// ─── User (Minimal Shadow Model) ───────────────────────────
// We only need the ID and basic fields for platform features
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Platform Fields
  lastLoginAt      DateTime?
  streakCount      Int       @default(0)
  lastPracticeDate String?

  // Relations
  analyticsEvents      AnalyticsEvent[]
  fraudEvents          FraudEvent[]
  badges               UserBadge[]
  assignedTasksAsUser  AssignedTask[]        @relation("UserTasks")
  assignedTasksAsManager AssignedTask[]      @relation("ManagerTasks")
  promoCodeRedemptions PromoCodeRedemption[]
  referralLinks        ReferralLink[]
  referralCreditsGiven ReferralCredit[]      @relation("ReferrerUser")
  referralCreditsGained ReferralCredit[]     @relation("ReferredUser")
}

// ─── Analytics & Security ──────────────────────────────────
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventName String
  metadata  Json?
  sessionId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([userId, eventName, createdAt])
}

model FraudEvent {
  id           String   @id @default(cuid())
  userId       String?
  ip           String?
  eventType    String
  severity     String   @default("low")
  metadataJson Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ip, createdAt])
}

// ─── Gamification ──────────────────────────────────────────
model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  imageUrl    String?
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String?
  pointCost   Int
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  rewardId  String
  userId    String
  status    String   @default("PENDING") // PENDING, APPROVED, SHIPPED
  createdAt DateTime @default(now())
  reward    Reward   @relation(fields: [rewardId], references: [id])
}

// ─── Referrals & Promo Codes ───────────────────────────────
model PromoCode {
  id          String                @id @default(cuid())
  code        String                @unique
  type        String                @default("campaign")
  discount    Float?
  startsAt    DateTime?
  expiresAt   DateTime?
  maxUses     Int?
  currentUses Int                   @default(0)
  status      String                @default("active")
  redemptions PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id          String    @id @default(cuid())
  userId      String
  code        String
  promoCodeId String
  ip          String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])

  @@index([userId, code])
}

model ReferralLink {
  id          String   @id @default(cuid())
  referralId  String   @unique
  ownerUserId String
  createdAt   DateTime @default(now())
  status      String   @default("active")
  user        User     @relation(fields: [ownerUserId], references: [id])
}

model ReferralCredit {
  id             String    @id @default(cuid())
  referrerUserId String
  referredUserId String
  status         String    @default("pending")
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  referrerUser   User      @relation("ReferrerUser", fields: [referrerUserId], references: [id])
  referredUser   User      @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@unique([referrerUserId, referredUserId])
}

// ─── Task Management ───────────────────────────────────────
model AssignedTask {
  id         String     @id @default(cuid())
  managerId  String
  userId     String
  type       String     // workout, meal, hydration, general
  name       String
  deadline   DateTime?
  status     TaskStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  user       User       @relation("UserTasks", fields: [userId], references: [id])
  manager    User       @relation("ManagerTasks", fields: [managerId], references: [id])
}
