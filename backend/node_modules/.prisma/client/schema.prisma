// ─── Prisma Schema for FitSpace ────────────────────────────
// Models: User, Meal, Workout, WaterLog, SleepLog, MoodLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals     Meal[]
  workouts  Workout[]
  waterLogs WaterLog[]
  sleepLogs SleepLog[]
  moodLogs  MoodLog[]
}

// ─── Meal ──────────────────────────────────────────────────
model Meal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  description String
  mealType    String // breakfast, lunch, dinner, snack
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  aiAnalysis  String? // raw AI response JSON
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ─── Workout ───────────────────────────────────────────────
model Workout {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // cardio, strength, flexibility, sports, etc.
  name      String
  duration  Int // minutes
  calories  Float?
  notes     String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Water Intake ──────────────────────────────────────────
model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float // milliliters
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Sleep ─────────────────────────────────────────────────
model SleepLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hours     Float
  quality   Int // 1-5 rating
  notes     String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Mood / Wellness ───────────────────────────────────────
model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      String // happy, calm, stressed, tired, energetic, sad
  energy    Int // 1-5
  notes     String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}
